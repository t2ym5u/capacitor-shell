{
  "name": "capacitor-shell",
  "version": "1.3.0",
  "description": "Capacitor shell that wraps a remote web app in a native iOS/Android container",
  "scripts": {
    "setup": "node setup.js",
    "setup:dev": "node setup.js --config config.dev.json",
    "setup:prod": "node setup.js --config config.prod.json",
    "setup:interactive": "node setup.js --interactive",
    "check": "node setup.js --check",
    "check:dev": "node setup.js --check --config config.dev.json",
    "check:prod": "node setup.js --check --config config.prod.json",
    "reset": "node setup.js --reset",
    "assets": "node assets.js",
    "assets:dev": "node assets.js --config config.dev.json",
    "assets:prod": "node assets.js --config config.prod.json",
    "sync": "pnpm exec cap sync",
    "open:android": "pnpm exec cap open android",
    "open:ios": "pnpm exec cap open ios",
    "run:android": "pnpm exec cap run android",
    "run:ios": "pnpm exec cap run ios"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@capacitor/android": "8.3.0",
    "@capacitor/core": "8.3.0",
    "@capacitor/ios": "8.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.3.0",
    "typescript": "6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
